# Public site URL (used for canonical, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://zimoco-demo.vercel.app
# WhatsApp number in international format, digits only (verify with client)
NEXT_PUBLIC_WHATSAPP_NUMBER=263772262946
# Prismic: the repo name is fixed to "xcgt84rk" in prismic.config.json.
# Do NOT set NEXT_PUBLIC_PRISMIC_ENVIRONMENT / NEXT_PUBLIC_PRISMIC_REPO (the guard refuses anything but xcgt84rk).
# Secret for the Prismic webhook that calls /api/revalidate (any long random string; use the same in Prismic's webhook settings)
REVALIDATE_SECRET=
# Optional later: MongoDB for leads, PostHog key
# MONGODB_URI=
# NEXT_PUBLIC_POSTHOG_KEY=
